# Copy to .env and fill in. docker compose reads this file twice:
# - to interpolate compose.yml (the "Stack" variables below);
# - as env_file of the bootstrap and of every replica, so all the replicas share the same configuration.
#
# Managed by compose.yml and NOT overridable here: CAT_REDIS_HOST, CAT_REDIS_PORT, CAT_QDRANT_HOST, CAT_DEBUG,
# CAT_HTTPS_PROXY_MODE, CAT_CORS_FORWARDED_ALLOW_IPS.

# ------------------------------------------------------------------ Stack

# Image of grinning-cat-core run by the bootstrap and by the replicas (always the same one): standard or hardened (DHI)
# CAT_IMAGE=ghcr.io/grinning-cat-rag/grinning-cat-core:latest

# Number of replicas of grinning-cat-core (`docker compose up --scale grinning-cat-core=N` overrides it)
# CAT_REPLICAS=3

# Host port where Traefik publishes the API
# CAT_PUBLIC_PORT=1865

# Log level of the replicas
# CAT_LOG_LEVEL=INFO

# Proxies in front of Traefik (load balancer, TLS terminator) whose X-Forwarded-* headers are trusted:
# comma-separated IPs/CIDRs, without spaces. Without them, behind such a proxy every request seems to come from the
# proxy. The proxy must overwrite X-Forwarded-For, not append to it (see the README)
# CAT_TRUSTED_PROXIES=10.0.0.0/8

# Images of the other services, pinned: change them to upgrade on purpose
# REDIS_IMAGE=redis/redis-stack-server:7.4.0-v8
# QDRANT_IMAGE=qdrant/qdrant:v1.19.1
# TRAEFIK_IMAGE=traefik:v3.7.13

# --------------------------------------------------------------- Required

# Protect endpoints with an access token (>= 16 characters recommended)
CAT_API_KEY=<your_api_key>

# JWT secret: the app refuses to start if missing, a known default or < 32 chars.
# Generate it with: python -c "import secrets; print(secrets.token_urlsafe(64))"
CAT_JWT_SECRET=<your_jwt_secret>

# ---------------------------------------------------------- Recommended

# Keys used to encrypt / decrypt privacy data: the defaults are public
# CAT_CRYPTO_KEY=<your_cryptography_key>
# CAT_CRYPTO_SALT=<your_cryptography_salt>

# Password of the default admin user: the default (admin) is public
# CAT_ADMIN_DEFAULT_PASSWORD=<your_admin_password>

# CAT_CORS_ALLOWED_ORIGINS is also the allow-list for cookie (`jwt=`) authentication: a cookie coming from any
# other cross-site Origin (HTTP or WebSocket) is ignored. List here the origins of your frontends (e.g. the admin).
# CAT_CORS_ENABLED=true
# CAT_CORS_ALLOWED_ORIGINS=https://example.org,https://www.example.org

# --------------------------------------------------------------- Optional

# JWT expiration (minutes); refresh token idle lifetime and absolute session lifetime (minutes)
# CAT_JWT_EXPIRE_MINUTES=15
# CAT_JWT_REFRESH_EXPIRE_MINUTES=10080
# CAT_JWT_REFRESH_MAX_LIFETIME_MINUTES=43200

# Brute-force protection on /auth/token and /auth/refresh (fixed window, shared by the replicas via Redis)
# CAT_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# CAT_AUTH_MAX_ATTEMPTS_PER_IP=30
# CAT_AUTH_MAX_FAILURES_PER_USER=10
# CAT_AUTH_MAX_REFRESH_PER_IP=120

# Expiration of the conversation history in Redis (minutes)
# CAT_HISTORY_EXPIRATION=30

# Document ingestion (values per replica)
# CAT_INGESTION_MAX_CONCURRENCY=2
# CAT_INGESTION_WORKERS=2
# CAT_INGESTION_NICENESS=5
# CAT_INGESTION_RESUME_INTERVAL_SECONDS=60
# CAT_INGESTION_HEARTBEAT_SECONDS=30
